# ─────────────────────────────────────────────────────────────────────────────
# XAU/USD Signal Dashboard — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Instrument (do not change) ────────────────────────────────────────────────
SUPPORTED_INSTRUMENT=xauusd
XAUUSD_MODE=MONITOR_ONLY

# ── Data mode ─────────────────────────────────────────────────────────────────
# demo  → seeded mock candles, no API key required (safe default)
# live  → routes to the configured provider (requires valid API key)
DATA_MODE=demo
FX_DATA_PROVIDER=twelvedata
FX_API_KEY=your_fx_api_key_here

# ── Economic calendar provider ────────────────────────────────────────────────
CALENDAR_PROVIDER=fmp
CALENDAR_API_KEY=your_calendar_api_key_here

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./xauusd_signals.db

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON array — add your VPS domain here when deploying
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ── Broker execution (permanently disabled — do not enable) ──────────────────
# Execution is blocked by design. Never enable these unless you have completed:
#   - 100+ backtested setups with positive expectancy
#   - 50+ paper-traded signals with documented results
#   - Risk management review and drawdown analysis
BROKER_EXECUTION_ENABLED=false
BROKER_PROVIDER=oanda
BROKER_API_KEY=
BROKER_ACCOUNT_ID=
MAX_RISK_PER_TRADE_PERCENT=0.25
DAILY_LOSS_LIMIT_PERCENT=1.0

# ── MT5 demo integration (XAU/USD only) ──────────────────────────────────────
# MetaTrader5 is Windows-only. Leave MT5_ENABLED=false on Linux/Docker.
# MT5 symbol candidates: XAUUSD | XAUUSDm | GOLD | XAUUSD.raw | XAUUSD.
# SECURITY: Never commit .env to git.
MT5_ENABLED=false
MT5_MODE=demo
MT5_SERVER=
MT5_LOGIN=0
MT5_PASSWORD=
MT5_EXECUTION_ENABLED=false
ALLOW_DEMO_TRADING=false
MAX_OPEN_TRADES=1
MAX_SPREAD_XAUUSD_POINTS=5.0

# ── Telegram signal alerts (XAU/USD only) ────────────────────────────────────
# Alerts fire for XAU/USD BUY/SELL signals: score>=80, RR>=2.5, news CLEAR.
# WAIT signals, low-score setups, and duplicate signals are never sent.
# Alerts are NOTIFICATION ONLY — they do not place or modify trades.
#
# Setup steps:
#   1. Open Telegram → search @BotFather → /newbot → copy token.
#   2. Send a message to your bot, then visit:
#        https://api.telegram.org/bot<TOKEN>/getUpdates
#      Copy the "chat":{"id":...} value as TELEGRAM_CHAT_ID.
#   3. Set TELEGRAM_ALERTS_ENABLED=true and fill BOT_TOKEN and CHAT_ID below.
#   4. Restart the backend.
#   5. POST /api/v1/alerts/telegram/test to verify delivery.
#
# SECURITY: NEVER commit your bot token to git.
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_ALERT_COOLDOWN_MINUTES=15
TELEGRAM_SIGNAL_ALERTS=true
TELEGRAM_CONFIRM_ALERTS=true
TELEGRAM_TRADE_ALERTS=true

# ── TradingView candle data ───────────────────────────────────────────────────
# Symbol: OANDA:XAUUSD (confirmed working — returns real gold prices)
# Set TRADINGVIEW_ENABLED=true and provide credentials to use real OHLCV data.
TRADINGVIEW_ENABLED=false
TRADINGVIEW_USERNAME=your_tv_username_here
TRADINGVIEW_PASSWORD=your_tv_password_here

# ── MyFXBook sentiment ────────────────────────────────────────────────────────
MYFXBOOK_ENABLED=false
MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=

# ── Auth (optional API key protection) ───────────────────────────────────────
AUTH_ENABLED=false
API_KEY=change_me
