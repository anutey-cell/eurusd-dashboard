DATA_MODE=demo
FX_DATA_PROVIDER=twelvedata
FX_API_KEY=your_fx_api_key_here
CALENDAR_PROVIDER=fmp
CALENDAR_API_KEY=your_calendar_api_key_here
DATABASE_URL=sqlite:///./eurusd_signals.db
# JSON array — add your VPS domain here when deploying
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ── Broker execution (disabled by default) ────────────────────────────────────
# Enable ONLY after 100+ backtested setups, 50+ paper-traded signals,
# positive expectancy, and acceptable drawdown have been verified.
BROKER_EXECUTION_ENABLED=false
BROKER_PROVIDER=oanda
BROKER_API_KEY=
BROKER_ACCOUNT_ID=
MAX_RISK_PER_TRADE_PERCENT=0.25
DAILY_LOSS_LIMIT_PERCENT=1.0

# ── MT5 demo integration (Phase 2) ───────────────────────────────────────────
# MetaTrader5 is Windows-only. Leave MT5_ENABLED=false on Linux/Docker.
# SECURITY: Never commit .env to git. .env is in .gitignore.
MT5_ENABLED=false
MT5_MODE=demo
MT5_SERVER=
MT5_LOGIN=0
MT5_PASSWORD=
MT5_EXECUTION_ENABLED=false
ALLOW_DEMO_TRADING=false
MAX_OPEN_TRADES=1
MAX_SPREAD_EURUSD_PIPS=2.0
MAX_SPREAD_XAUUSD_POINTS=5.0

# ── Telegram signal alert notifications ──────────────────────────────────────
# Alerts fire for BUY/SELL signals with score>=80, RR>=2.5, news CLEAR.
# WAIT signals, low-score setups, and duplicate signals are never sent.
# Alerts are NOTIFICATION ONLY — they do not place or modify trades.
#
# Setup steps:
#   Step 1: Open Telegram → search @BotFather → /newbot → copy the token.
#   Step 2: Send any message to your bot, then visit:
#             https://api.telegram.org/bot<TOKEN>/getUpdates
#           Copy the "chat":{"id":...} value as TELEGRAM_CHAT_ID.
#   Step 3: Set TELEGRAM_ALERTS_ENABLED=true, fill BOT_TOKEN and CHAT_ID below.
#   Step 4: Restart the backend.
#   Step 5: POST /api/v1/alerts/telegram/test to verify delivery.
#
# SECURITY: NEVER commit your bot token to git. This file is safe (.env is gitignored).
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_ALERT_COOLDOWN_MINUTES=15
TELEGRAM_SIGNAL_ALERTS=true
TELEGRAM_CONFIRM_ALERTS=true
TELEGRAM_TRADE_ALERTS=true
