# ─────────────────────────────────────────────────────────────────────────────
# XAU/USD Signal Dashboard — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Instrument (do not change) ────────────────────────────────────────────────
SUPPORTED_INSTRUMENT=xauusd
XAUUSD_MODE=MONITOR_ONLY

# ── Data mode ─────────────────────────────────────────────────────────────────
# demo  → seeded mock candles, no API key required (safe default)
# live  → routes to the configured provider (requires valid API key)
DATA_MODE=demo
FX_DATA_PROVIDER=twelvedata
FX_API_KEY=your_fx_api_key_here

# ── Economic calendar provider ────────────────────────────────────────────────
CALENDAR_PROVIDER=fmp
CALENDAR_API_KEY=your_calendar_api_key_here

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./xauusd_signals.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array — add your VPS domain here when deploying
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ── Broker execution (permanently disabled during takeover) ───────────────────
BROKER_EXECUTION_ENABLED=false
BROKER_PROVIDER=oanda
BROKER_API_KEY=
BROKER_ACCOUNT_ID=
MAX_RISK_PER_TRADE_PERCENT=0.25
DAILY_LOSS_LIMIT_PERCENT=1.0

# ── MT5 demo integration (XAU/USD only) ──────────────────────────────────────
# MetaTrader5 is Windows-only. Leave MT5_ENABLED=false on Linux/Docker.
# Direct/local MT5 order_send is disabled by takeover policy. Executable demo
# orders must use PendingExecution -> hardened Windows bridge.
MT5_ENABLED=false
MT5_MODE=demo
MT5_SERVER=
MT5_LOGIN=0
MT5_PASSWORD=
MT5_EXECUTION_ENABLED=false
ALLOW_DEMO_TRADING=false
MAX_OPEN_TRADES=1
MAX_SPREAD_XAUUSD_POINTS=5.0

# ── MT5 bridge ────────────────────────────────────────────────────────────────
# Generate the shared secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep the same value in the VPS .env and Windows deploy/.env.bridge.
MT5_BRIDGE_ENABLED=false
MT5_BRIDGE_SHARED_SECRET=
# Only populate during an intentional secret rotation window; clear afterwards.
MT5_BRIDGE_SHARED_SECRET_PREV=

# ── Autonomous legacy execution (disabled during takeover) ────────────────────
AUTO_EXECUTION_ENABLED=false
AUTO_EXECUTION_MAX_LOT=0.05
AUTO_EXECUTION_MAX_TRADES_PER_DAY=3
AUTO_EXECUTION_INTERVAL_SEC=60
# Must remain false during takeover; live-account execution is not authorised.
LIVE_TRADING_AUTHORIZED=false
# Canonical architecture selector.
USE_MANDATE_STRATEGIST=true

# ── Telegram signal alerts (XAU/USD only) ────────────────────────────────────
# SECURITY: NEVER commit bot tokens or chat IDs.
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_ALERT_COOLDOWN_MINUTES=15
TELEGRAM_SIGNAL_ALERTS=true
TELEGRAM_CONFIRM_ALERTS=true
TELEGRAM_TRADE_ALERTS=true

# ── TradingView candle data ───────────────────────────────────────────────────
TRADINGVIEW_ENABLED=false
TRADINGVIEW_USERNAME=your_tv_username_here
TRADINGVIEW_PASSWORD=your_tv_password_here

# ── MyFXBook sentiment ────────────────────────────────────────────────────────
MYFXBOOK_ENABLED=false
MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=

# ── Operator/control-plane authentication ────────────────────────────────────
# A STRONG non-placeholder API_KEY is mandatory for takeover control endpoints
# even when AUTH_ENABLED=false. It protects side-effectful Strategist/Execution
# endpoints. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do not use 'change_me'.
AUTH_ENABLED=false
API_KEY=
