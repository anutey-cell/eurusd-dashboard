# ============================================================================
# XAU/USD Signal Dashboard — Production .env (VPS)
# ============================================================================
# Copy this to deploy/.env.prod on the VPS and fill in real values.
#
#   cp deploy/.env.prod.example deploy/.env.prod
#   nano deploy/.env.prod
#
# DO NOT commit .env.prod to git. It contains secrets.
# DO NOT include shell quoting (export VAR="...") — this is a plain KEY=VALUE file.
# ============================================================================

# ── Public hostname (used by Caddy + CORS) ───────────────────────────────────
# This is the DuckDNS name you registered. Caddy reads it via {$FQDN}.
FQDN=xauusd-anwar.duckdns.org


# ── Data mode ────────────────────────────────────────────────────────────────
DATA_MODE=live


# ── Candle provider (TradingView session is free, no API key) ────────────────
# Leave TradingView creds blank to use anonymous public access (may rate-limit).
# Supply username+password for the same TradingView account you log into normally.
TRADINGVIEW_ENABLED=true
TRADINGVIEW_USERNAME=
TRADINGVIEW_PASSWORD=


# ── Macro calendar (free ForexFactory — no key required) ─────────────────────
CALENDAR_PROVIDER=forexfactory
CALENDAR_API_KEY=


# ── FRED yields (free API key from https://fred.stlouisfed.org/docs/api/) ────
FRED_API_KEY=ac972cc6881e770e091eead7a25e459d


# ── MyFxBook sentiment (optional — leave disabled if no account) ─────────────
MYFXBOOK_ENABLED=false
MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=


# ── Telegram alerts (THE WHOLE POINT of running on VPS — get these right) ────
# 1. Talk to @BotFather on Telegram, /newbot, copy the token here
# 2. Talk to your bot once, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id (look for "chat":{"id": ... })
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SIGNAL_ALERTS=true
TELEGRAM_TRADE_ALERTS=true
TELEGRAM_CONFIRM_ALERTS=true
TELEGRAM_ALERT_COOLDOWN_MINUTES=15


# ── MT5 hybrid execution (the "remote bridge" model) ─────────────────────────
# The VPS produces signed BUY/SELL orders; your Windows laptop runs the
# `mt5_bridge_daemon.py` script which polls /api/v1/execution/pending-orders
# every 30 seconds and places them on MT5. See deploy/04-mt5-bridge.md.
#
# MT5_BRIDGE_ENABLED gates whether the VPS even produces pending orders.
# When false → VPS sends Telegram alerts only, no execution attempts.
MT5_BRIDGE_ENABLED=true
# Shared secret between VPS and laptop daemon — generate a long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MT5_BRIDGE_SHARED_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING


# ── Autonomous executor caps (3-layer confirmation gate) ─────────────────────
# These guard whatever the laptop bridge actually fires. Same semantics as
# before: max 0.05 lot, max 3 trades per UTC day, ALL 3 confirmation layers
# must agree (scanner + predictor + killzone).
AUTO_EXECUTION_ENABLED=true
AUTO_EXECUTION_MAX_LOT=0.05
AUTO_EXECUTION_MAX_TRADES_PER_DAY=3
AUTO_EXECUTION_INTERVAL_SEC=60
LIVE_TRADING_AUTHORIZED=true


# ── Local MT5 settings (NOT used on VPS — the bridge daemon reads these
# from its own .env on your Windows laptop). Listed here so the backend
# config doesn't error on missing keys.
MT5_ENABLED=false
MT5_MODE=demo
MT5_SERVER=
MT5_LOGIN=0
MT5_PASSWORD=
MT5_EXECUTION_ENABLED=false
ALLOW_DEMO_TRADING=false


# ── CORS origins ─────────────────────────────────────────────────────────────
# The dashboard is hosted on the FQDN so that's the only allowed origin.
# Caddy fronts everything on https://, so no port suffix.
CORS_ORIGINS=["https://xauusd-anwar.duckdns.org"]


# ── API auth (set true for production to require an API key for write routes) ─
AUTH_ENABLED=false
API_KEY=change_me


# ── Rate limit backend (memory is fine for single-node VPS) ──────────────────
RATE_LIMIT_BACKEND=memory


# ── Background scheduler tunables (defaults are sensible) ───────────────────
# SCANNER_INTERVAL_SEC=60
# PREDICTION_INTERVAL_SEC=300
# DRAWDOWN_INTERVAL_SEC=1800
# DAILY_SUMMARY_HOUR_UTC=7
