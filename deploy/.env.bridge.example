# =====================================================================
# MT5 Bridge Daemon Environment (RUNS ON YOUR WINDOWS LAPTOP)
# =====================================================================
# Copy to ".env.bridge" in the SAME folder as mt5_bridge_daemon.py.
# The daemon reads it on startup.
#
# =====================================================================

# Public URL of your VPS dashboard (the DuckDNS HTTPS endpoint)
DASHBOARD_URL=https://xauusd-anwar.duckdns.org

# Shared secret MUST match MT5_BRIDGE_SHARED_SECRET on the VPS .env.prod
BRIDGE_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING

# Optional: human-friendly daemon ID shown in the dashboard's heartbeat list
# Defaults to "<hostname>-<6char>" if blank
DAEMON_ID=

# How often to poll the VPS for pending orders (seconds)
POLL_SEC=30

# How often to send a heartbeat to /api/v1/bridge/health (seconds)
HEARTBEAT_SEC=60

# MT5 account credentials — same ones the existing local config uses.
# The daemon uses these to mt5.initialize(login=, password=, server=)
MT5_LOGIN=435888680
MT5_PASSWORD=Juneid@24
MT5_SERVER=Exness-MT5Trial9
